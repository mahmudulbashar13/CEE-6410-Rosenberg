Equation Listing    SOLVE NETWORK Using LP From line 85


---- COST  =E=  Total cost ($) and objective function value

COST..  - 4*X(Kansas,Newyork) - 12*X(Kansas,Minneapolis) - 18*X(Kansas,Seattle) - 18*X(Kansas,Sanfrancisco) - 9*X(Dallas,Newyork) - 15*X(Dallas,Minneapolis) - 17*X(Dallas,Seattle) - 21*X(Dallas,Sanfrancisco) + VCOST =E= 0 ; (LHS = 0)
     

---- RES_CONSTRAIN1  =L=  constraint of how many cars are in stock for each supplier

RES_CONSTRAIN1(Kansas)..  X(Kansas,Newyork) + X(Kansas,Minneapolis) + X(Kansas,Seattle) + X(Kansas,Sanfrancisco) =L= 1000 ; (LHS = 0)
     
RES_CONSTRAIN1(Dallas)..  X(Dallas,Newyork) + X(Dallas,Minneapolis) + X(Dallas,Seattle) + X(Dallas,Sanfrancisco) =L= 800 ; (LHS = 0)
     

---- RES_CONSTRAIN2  =G=  constraint of minimum number of cars sold by each dealer

RES_CONSTRAIN2(Newyork)..  X(Kansas,Newyork) + X(Dallas,Newyork) =G= 400 ; (LHS = 0, INFES = 400 ****)
     
RES_CONSTRAIN2(Minneapolis)..  X(Kansas,Minneapolis) + X(Dallas,Minneapolis) =G= 250 ; (LHS = 0, INFES = 250 ****)
     
RES_CONSTRAIN2(Seattle)..  X(Kansas,Seattle) + X(Dallas,Seattle) =G= 450 ; (LHS = 0, INFES = 450 ****)
     
RES_CONSTRAIN2(Sanfrancisco)..  X(Kansas,Sanfrancisco) + X(Dallas,Sanfrancisco) =G= 450 ; (LHS = 0, INFES = 450 ****)
     
