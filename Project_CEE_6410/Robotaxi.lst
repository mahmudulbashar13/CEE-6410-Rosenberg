  56  *****************************************
  57  ** PART I. Simpler Problem Ignoring Status Tracking of Each Vehicle
  58  ********************************
  59   
  60  *1. Define the sets
  61  SETS v  vehicles / v1*v100 /
  62       t windows  / morning, afternoon, evening /;
  63   
  64  *2. Define th input data
  65  Parameter demand(t) trips demand in each window / morning 200, afternoon 170, evening 240 /;
  66   
  67  Scalars
  68     maxTrips max trips per vehicle per window          / 4  /
  69     revenue  revenue per trip ($)                      / 50 /
  70     opCost   operating cost per deployed vehicle per window ($) / 80 /;
  71   
  72   
  73  *3. Define the decision variables
  74  BINARY VARIABLES deploy(v,t);
  75  INTEGER VARIABLES trips(v,t);
  76  VARIABLE profit;
  77  trips.UP(v,t) = maxTrips;
  78   
  79  *4. Define the equations
  80  Equations
  81      obj Revenue from trips - Operational costs
  82      cap(v,t) A vehicle serves trips only if deployed and maximum trips in a window is limited to 4
  83      dem(t)  The trips served in a window can not exceed demand;
  84   
  85   
  86  obj..      profit =e= sum((v,t), revenue*trips(v,t) - opCost*deploy(v,t));
  87  cap(v,t).. trips(v,t) =l= maxTrips*deploy(v,t);
  88  dem(t)..   sum(v, trips(v,t)) =l= demand(t);
  89   
  90   
  91  Model deployModel / all /;
  92  Solve deployModel using mip maximizing profit;
  93   
  94  Parameter deployed(t), served(t);
  95  Scalar totalTrips;
  96  deployed(t) = sum(v, deploy.l(v,t));
  97  served(t)   = sum(v, trips.l(v,t));
  98  totalTrips  = sum(t, served(t));
  99  display profit.l, deployed, served, totalTrips;


