Equation Listing    SOLVE Irrig Using MIP From line 102


---- COST  =E=  Total Cost ($) and objective function value

COST..  10000*I(rh) + 6000*I(rl) + 8000*I(p) + 20*X(p,y1) + 20*X(p,y2) - 300*AC + TCOST =E= 0 ; (LHS = 0)
     

---- massbal  =E=  reservoir mass balance

massbal(y1)..  X(rh,y1) + X(rl,y1) + Spill(y1) - S(y1) + S(y2) =E= 600 ; (LHS = 0, INFES = 600 ****)
     
massbal(y2)..  X(rh,y2) + X(rl,y2) + Spill(y2) + S(y1) - S(y2) =E= 200 ; (LHS = 0, INFES = 200 ****)
     

---- demand  =G=  crop water demand

demand(y1)..  X(rh,y1) + X(rl,y1) + X(p,y1) - AC =G= 0 ; (LHS = 0)
     
demand(y2)..  X(rh,y2) + X(rl,y2) + X(p,y2) - 3*AC =G= 0 ; (LHS = 0)
     

---- storcap  =L=  storage limited by reservoir built

storcap(y1)..  - 700*I(rh) - 300*I(rl) + S(y1) =L= 0 ; (LHS = 0)
     
storcap(y2)..  - 700*I(rh) - 300*I(rl) + S(y2) =L= 0 ; (LHS = 0)
     

---- relcap_h  =L=  release only if high reservoir built

relcap_h(y1)..  - 1300*I(rh) + X(rh,y1) =L= 0 ; (LHS = 0)
     
relcap_h(y2)..  - 900*I(rh) + X(rh,y2) =L= 0 ; (LHS = 0)
     

---- relcap_l  =L=  release only if low reservoir built

relcap_l(y1)..  - 900*I(rl) + X(rl,y1) =L= 0 ; (LHS = 0)
     
relcap_l(y2)..  - 500*I(rl) + X(rl,y2) =L= 0 ; (LHS = 0)
     

---- pumpcap  =L=  pump capacity

pumpcap(y1)..  - 396*I(p) + X(p,y1) =L= 0 ; (LHS = 0)
     
pumpcap(y2)..  - 396*I(p) + X(p,y2) =L= 0 ; (LHS = 0)
     

---- pumpriver  =L=  pump limited by river flow

pumpriver(y1)..  X(p,y1) - Spill(y1) =L= 360 ; (LHS = 0)
     
pumpriver(y2)..  X(p,y2) - Spill(y2) =L= 360 ; (LHS = 0)
     

---- onereservoir  =L=  at most one reservoir

onereservoir..  I(rh) + I(rl) =L= 1 ; (LHS = 0)
     
